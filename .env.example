# ============================================================
# Belya & Belya Harness — VPS Deployment Environment Configuration
# ============================================================

# --- LLM Provider Settings ---
# Option A: OpenRouter Production (DeepSeek V4.1 Flash Recommended: 1.048M Context, $0.0042/M Cache Read)
MODEL_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
MODEL_NAME=deepseek/deepseek-v4.1-flash
MODEL_API_KEY=sk-or-v1-...

# Option B: Local Ollama / vLLM running on your VPS
# MODEL_ENDPOINT=http://localhost:11434/v1/chat/completions
# MODEL_NAME=hermes-3
# MODEL_API_KEY=none

# Option C: Cloud Providers (OpenAI / Groq)
# MODEL_ENDPOINT=https://api.openai.com/v1/chat/completions
# MODEL_NAME=gpt-4o
# MODEL_API_KEY=sk-...

# --- Jev TypeSafe AI Decision Coprocessor (Optional) ---
# Sub-200ms structured decision engine for fast subagent triage, tool-call risk gating, and context filtering
# Sign up and get your API key at: https://jevtypesafeai.com
# JEV_API_KEY=jv_live_...

# --- Telegram Bot Settings ---
# Create a bot via @BotFather on Telegram to get your token
TELEGRAM_BOT_TOKEN=123456789:ABCDefGhIJKlmNoPQRsTUVwxyZ

# YOUR TELEGRAM USER/CHAT ID (Find it by messaging @userinfobot on Telegram)
# CRITICAL FOR VPS SECURITY: Only messages from this Chat ID will be accepted!
TELEGRAM_CHAT_ID=987654321

# --- Optional Gateway Timeouts ---
MODEL_TIMEOUT=120
MODEL_MAX_RETRIES=3

# --- Optional: HTTP User-Agent sent to the LLM gateway ---
# Some relay gateways filter clients by fingerprint and return HTTP 401 for
# unrecognised User-Agents BEFORE evaluating the API key. Defaults to
# "BelyaAgent/7.0 (Autonomous C99 Engine)" when unset. Example override:
# MODEL_USER_AGENT=claude-cli/2.0.0 (external, cli)
